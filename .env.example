# GEMINI_API_KEY: Required if Gemini AI API calls are used.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Server HTTP port (defaults to 3000).
PORT=3000

# SESSION_SECRET: Secret key used to sign server-side session tokens.
# Set a strong random string in production.
SESSION_SECRET=""

# FIREBASE_PROJECT_ID (optional server override when not using firebase-applet-config.json)
FIREBASE_PROJECT_ID=""

# VITE_FIREBASE_* (optional client overrides for GitHub/external deployments)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""

# ADMIN_USERNAME & ADMIN_PASSWORD (optional):
# Optional initial admin seed credentials stored hashed in SQLite at first boot.
# Leave blank to create the first admin account interactively in /admin.
ADMIN_USERNAME=""
ADMIN_PASSWORD=""
