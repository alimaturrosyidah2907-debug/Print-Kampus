# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Secret key used to sign server-side session tokens.
# If omitted in development, a random ephemeral secret is generated at boot.
SESSION_SECRET=""

# ADMIN_USERNAME & ADMIN_PASSWORD (optional):
# Optional initial admin seed credentials stored hashed in SQLite at first boot.
# Leave blank to create the first admin account interactively in /admin.
ADMIN_USERNAME=""
ADMIN_PASSWORD=""
